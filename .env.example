# Copy this file to .env and fill in the empty values.
# docker compose, `next dev` and the Prisma CLI all read the same file.

# --- Database ---------------------------------------------------------------
# Connection string for `npm run dev` and the Prisma CLI on your machine.
# Inside docker compose the app and the migration job get their own URL, built from the
# POSTGRES_* values below, because the database host there is "db".
DATABASE_URL=postgresql://opentask:change-me@localhost:5432/opentask

# Used by docker compose to create and reach the database container. Keep the password
# URL-safe, for example: openssl rand -hex 24
POSTGRES_USER=opentask
POSTGRES_PASSWORD=
POSTGRES_DB=opentask
# Host port for the database. It is bound to 127.0.0.1 only.
DB_PORT=5432

# --- Authentication (Better Auth) -------------------------------------------
# The public URL of the app exactly as you open it in the browser: scheme, host and port,
# no trailing slash. With the https profile this is https://<APP_DOMAIN>.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# More origins that may use the app, comma-separated. Optional.
BETTER_AUTH_TRUSTED_ORIGINS=
# Create your own account first, then set this to true and restart to close registration.
DISABLE_SIGNUP=false

# --- Docker deployment ------------------------------------------------------
# Where the app listens on the host. 127.0.0.1 keeps it private to the server itself. Set the IP
# of your WireGuard interface to open it to the VPN only (plain HTTP, without Caddy).
APP_BIND=127.0.0.1
APP_PORT=3000

# Only for `docker compose --profile https`: Caddy serves APP_DOMAIN (a domain name or the
# server's IP) with TLS on CADDY_BIND:443 and forwards to the app. Keep APP_BIND on 127.0.0.1.
# Uncomment the next line to start Caddy with a plain `docker compose up`, without the flag.
# COMPOSE_PROFILES=https
# If something else already uses port 80 or 443 (Pi-hole does), pick other ports below.
# Then the address of the app gets the port too, and so does BETTER_AUTH_URL.
CADDY_BIND=127.0.0.1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
APP_DOMAIN=
